{
  "name": "@glosign/sdk",
  "version": "0.1.0-beta.1",
  "description": "Glosign Open API SDK for electronic signature and contract workflows",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.js"
    },
    "./heuristics": {
      "types": "./heuristics.d.ts",
      "import": "./heuristics.js"
    }
  },
  "bin": {
    "glosign-init": "bin/glosign-init.js",
    "glosign-templates": "bin/glosign-templates.js",
    "glosign-contracts": "bin/glosign-contracts.js",
    "glosign-download": "bin/glosign-download.js"
  },
  "scripts": {
    "smoke:check": "node ./scripts/smoke-check.mjs",
    "pack:check": "node ./scripts/pack-check.mjs",
    "release:check": "npm run smoke:check && npm run pack:check",
    "prepublishOnly": "npm run release:check"
  },
  "files": [
    "client.js",
    "client.d.ts",
    "heuristics.js",
    "heuristics.d.ts",
    "index.js",
    "index.d.ts",
    "bin",
    "LICENSE",
    "README.md",
    "PUBLISHING.md",
    "SECURITY.md",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glosign-SDK/glosign-sdk-1.0.git"
  },
  "homepage": "https://github.com/Glosign-SDK/glosign-sdk-1.0",
  "bugs": {
    "url": "https://github.com/Glosign-SDK/glosign-sdk-1.0/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "glosign",
    "electronic-signature",
    "e-signature",
    "signature",
    "contracts",
    "contract-signing",
    "signed-pdf",
    "openapi",
    "전자서명",
    "전자계약"
  ]
}
